<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_A1D2_PlanFit_Optimised_v2"
  targetNamespace="https://www.auckland.ac.nz/infosys704/a1-d2/to-be/optimised/v2"
  exporter="Codex"
  exporterVersion="2.1">

  <bpmn:documentation>Optimised v2 generated against the Signavio Best Practice convention catalog at https://www.modeling-guidelines.org/conventions/signavio-best-practice/. Assistance-status propagation has been separated from displayed-output recording. This is a proposed analytical model, not a validated Spark internal process.</bpmn:documentation>

  <bpmn:message id="Message_Review_Request_Optimised" name="PlanFit review request"/>
  <bpmn:message id="Message_Assigned_Output_Optimised" name="Output or assistance status"/>
  <bpmn:message id="Message_Coded_Response_Optimised" name="Coded review response"/>
  <bpmn:message id="Message_Status_Optimised" name="Outcome or revised output"/>

  <bpmn:collaboration id="Collaboration_PlanFit_Optimised" name="PlanFit Navigator Core — Proposed TO-BE">
    <bpmn:documentation>Proposed analytical BPMN 2.0 collaboration for Spark-branded individual-consumer mobile plan-value review. It is not a validated Spark internal process.</bpmn:documentation>
    <bpmn:participant id="Participant_Customer_Optimised" name="Mobile customer" processRef="Process_Customer_Optimised"/>
    <bpmn:participant id="Participant_Spark_Optimised" name="Spark" processRef="Process_Spark_Optimised"/>
    <bpmn:messageFlow id="CMF01O" name="Review request" sourceRef="C02O" targetRef="S01O"/>
    <bpmn:messageFlow id="CMF02O" name="Output or assistance status" sourceRef="S03O" targetRef="C03O"/>
    <bpmn:messageFlow id="CMF03O" name="Coded response" sourceRef="C05O" targetRef="S04O"/>
    <bpmn:messageFlow id="CMF04O" name="Outcome or revised output" sourceRef="S07O" targetRef="C06O"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer_Optimised" name="Mobile customer PlanFit decision cycle" isExecutable="false">
    <bpmn:documentation>Customer-side decision cycle for the proposed PlanFit Navigator Core analytical model.</bpmn:documentation>
    <bpmn:startEvent id="C01O" name="Review need recognised"/>
    <bpmn:sendTask id="C02O" name="Send PlanFit review request" messageRef="Message_Review_Request_Optimised">
      <bpmn:documentation>Send the customer&apos;s request to start a Spark-branded individual-consumer mobile plan-value review.</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C03O" name="Receive output or assistance status" messageRef="Message_Assigned_Output_Optimised">
      <bpmn:documentation>Receive either the versioned output assigned to the customer&apos;s experimental arm or an assistance-required status when approved inputs are not valid and permitted.</bpmn:documentation>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="C04MO" name="Merge decision cycles"/>
    <bpmn:userTask id="C04O" name="Review evidence and choose response">
      <bpmn:documentation>Review the displayed evidence and choose Keep, Change, Correct, Help, Defer or Exit without hiding the no-change option.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:sendTask id="C05O" name="Send coded review response" messageRef="Message_Coded_Response_Optimised">
      <bpmn:documentation>Send the selected response code while retaining the assigned arm and displayed output version.</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C06O" name="Receive outcome or revised output" messageRef="Message_Status_Optimised">
      <bpmn:documentation>Receive the recorded outcome, assistance status, fulfilment status or revised output.</bpmn:documentation>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="C07O" name="Further decision required?"/>
    <bpmn:endEvent id="C08O" name="Review closed with recorded status"/>
    <bpmn:sequenceFlow id="CCF01O" sourceRef="C01O" targetRef="C02O"/>
    <bpmn:sequenceFlow id="CCF02O" sourceRef="C02O" targetRef="C03O"/>
    <bpmn:sequenceFlow id="CCF03O" sourceRef="C03O" targetRef="C04MO"/>
    <bpmn:sequenceFlow id="CCF04MO" sourceRef="C04MO" targetRef="C04O"/>
    <bpmn:sequenceFlow id="CCF04O" sourceRef="C04O" targetRef="C05O"/>
    <bpmn:sequenceFlow id="CCF05O" sourceRef="C05O" targetRef="C06O"/>
    <bpmn:sequenceFlow id="CCF06O" sourceRef="C06O" targetRef="C07O"/>
    <bpmn:sequenceFlow id="CCF07NO" name="No" sourceRef="C07O" targetRef="C08O"/>
    <bpmn:sequenceFlow id="CCF07YO" name="Yes — review again" sourceRef="C07O" targetRef="C04MO"/>
  </bpmn:process>

  <bpmn:process id="Process_Spark_Optimised" name="Spark PlanFit orchestration" isExecutable="false">
    <bpmn:documentation>Spark-side orchestration for one PlanFit customer decision cycle. Daily 90-day measurement is separated into its own timer-start process so this process has one unambiguous trigger.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Spark_Optimised">
      <bpmn:lane id="Lane_Digital_Optimised" name="Digital experience">
        <bpmn:flowNodeRef>S01O</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S03O</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S03GO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S04MO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S04O</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S07O</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S08O</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S09O</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Decision_Optimised" name="PlanFit decision service">
        <bpmn:flowNodeRef>S02O</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Response_Optimised" name="Response resolution and fulfilment">
        <bpmn:flowNodeRef>S05O</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analytics_Optimised" name="Analytics and governance">
        <bpmn:flowNodeRef>S03AO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S01O" name="PlanFit review request received">
      <bpmn:messageEventDefinition id="EventDef_S01O" messageRef="Message_Review_Request_Optimised"/>
    </bpmn:startEvent>
    <bpmn:callActivity id="S02O" name="Prepare matched PlanFit output" calledElement="Process_Output_Optimised">
      <bpmn:documentation>Invoke the linked process that returns either a matched comparator or treatment output, or an assistance-required status when approved inputs are not valid and permitted.</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:sendTask id="S03O" name="Send output or assistance status" messageRef="Message_Assigned_Output_Optimised">
      <bpmn:documentation>Send either the versioned assigned output or the assistance-required status returned by the linked preparation process.</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="S03GO" name="Assigned output displayed?"/>
    <bpmn:serviceTask id="S03AO" name="Record displayed output version">
      <bpmn:documentation>Record the assigned arm, output version and confirmed display event. Count R_c only after the assigned output is displayed.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S04MO" name="Merge response cycles"/>
    <bpmn:receiveTask id="S04O" name="Receive coded review response" messageRef="Message_Coded_Response_Optimised">
      <bpmn:documentation>Receive the customer&apos;s coded response together with the retained assignment and displayed output version.</bpmn:documentation>
    </bpmn:receiveTask>
    <bpmn:callActivity id="S05O" name="Resolve customer response" calledElement="Process_Response_Optimised">
      <bpmn:documentation>Invoke the linked response process to handle Keep, Change, Correct, Help, Defer or Exit and return a traceable status.</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:sendTask id="S07O" name="Send outcome or revised output" messageRef="Message_Status_Optimised">
      <bpmn:documentation>Send the recorded outcome, fulfilment status, assistance status or revised output to the customer.</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="S08O" name="Further decision required?"/>
    <bpmn:endEvent id="S09O" name="Journey orchestration closed"/>
    <bpmn:sequenceFlow id="CSF01O" sourceRef="S01O" targetRef="S02O"/>
    <bpmn:sequenceFlow id="CSF02O" sourceRef="S02O" targetRef="S03O"/>
    <bpmn:sequenceFlow id="CSF03O" sourceRef="S03O" targetRef="S03GO"/>
    <bpmn:sequenceFlow id="CSF03YO" name="Yes — valid output" sourceRef="S03GO" targetRef="S03AO"/>
    <bpmn:sequenceFlow id="CSF03NO" name="No — assistance status" sourceRef="S03GO" targetRef="S04MO"/>
    <bpmn:sequenceFlow id="CSF03AO" sourceRef="S03AO" targetRef="S04MO"/>
    <bpmn:sequenceFlow id="CSF04MO" sourceRef="S04MO" targetRef="S04O"/>
    <bpmn:sequenceFlow id="CSF04O" sourceRef="S04O" targetRef="S05O"/>
    <bpmn:sequenceFlow id="CSF05O" sourceRef="S05O" targetRef="S07O"/>
    <bpmn:sequenceFlow id="CSF07O" sourceRef="S07O" targetRef="S08O"/>
    <bpmn:sequenceFlow id="CSF08NO" name="No" sourceRef="S08O" targetRef="S09O"/>
    <bpmn:sequenceFlow id="CSF08YO" name="Yes — next response cycle" sourceRef="S08O" targetRef="S04MO"/>
  </bpmn:process>

  <bpmn:process id="Process_Output_Optimised" name="Prepare matched PlanFit output" isExecutable="false">
    <bpmn:documentation>Linked child process that creates an arm-equivalent comparator or explainable treatment output while preserving assignment integrity.</bpmn:documentation>
    <bpmn:startEvent id="O01O" name="Output requested"/>
    <bpmn:serviceTask id="O02O" name="Validate eligibility and preserve assignment">
      <bpmn:documentation>Validate review eligibility. Assign the H1Q arm once for a new case, retain it for correction cycles, and record N_g/R_s once.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="O03O" name="Retrieve approved review inputs">
      <bpmn:documentation>Retrieve only the approved plan, usage, spending and purpose-limited inputs needed for the review.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="O04O" name="Inputs valid and permitted?"/>
    <bpmn:serviceTask id="O05O" name="Return assistance-required status">
      <bpmn:documentation>Return an assistance-required status when inputs are invalid, unavailable or outside the approved purpose.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="O10AO" name="Assistance-required status ready"/>
    <bpmn:businessRuleTask id="O06O" name="Calculate fit and apply suitability rules">
      <bpmn:documentation>Apply the common cost, allowance, eligibility and suitability rules to the approved inputs before presentation.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="O07O" name="Which assigned H1Q arm?"/>
    <bpmn:serviceTask id="O08TO" name="Create explainable treatment output">
      <bpmn:documentation>Add a neutral fit or no-change conclusion, visible reasons, trade-offs and uncertainty to the common information.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="O10TO" name="Treatment output ready"/>
    <bpmn:serviceTask id="O08CO" name="Create equivalent comparator output">
      <bpmn:documentation>Show the equivalent plan, usage and spending information without the treatment conclusion or explanation.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="O10CO" name="Comparator output ready"/>
    <bpmn:sequenceFlow id="OF01O" sourceRef="O01O" targetRef="O02O"/>
    <bpmn:sequenceFlow id="OF02O" sourceRef="O02O" targetRef="O03O"/>
    <bpmn:sequenceFlow id="OF03O" sourceRef="O03O" targetRef="O04O"/>
    <bpmn:sequenceFlow id="OF04NO" name="No" sourceRef="O04O" targetRef="O05O"/>
    <bpmn:sequenceFlow id="OF05O" sourceRef="O05O" targetRef="O10AO"/>
    <bpmn:sequenceFlow id="OF04YO" name="Yes" sourceRef="O04O" targetRef="O06O"/>
    <bpmn:sequenceFlow id="OF06O" sourceRef="O06O" targetRef="O07O"/>
    <bpmn:sequenceFlow id="OF07TO" name="Treatment" sourceRef="O07O" targetRef="O08TO"/>
    <bpmn:sequenceFlow id="OF08TO" sourceRef="O08TO" targetRef="O10TO"/>
    <bpmn:sequenceFlow id="OF07CO" name="Comparator" sourceRef="O07O" targetRef="O08CO"/>
    <bpmn:sequenceFlow id="OF08CO" sourceRef="O08CO" targetRef="O10CO"/>
  </bpmn:process>

  <bpmn:process id="Process_Response_Optimised" name="Resolve customer response" isExecutable="false">
    <bpmn:documentation>Linked child process that resolves a coded PlanFit response through explicit binary decisions and distinct final statuses.</bpmn:documentation>
    <bpmn:startEvent id="R01O" name="Coded response received"/>
    <bpmn:businessRuleTask id="R02O" name="Classify coded response">
      <bpmn:documentation>Classify the immutable response code and retrieve the versioned review record that produced the displayed output.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="R03O" name="Help requested?"/>
    <bpmn:userTask id="R04O" name="Resolve explanation or record safe exception">
      <bpmn:documentation>Resolve the explanation request or record a safe assistance-required exception without inventing a customer decision.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:endEvent id="R05O" name="Assisted status ready"/>
    <bpmn:exclusiveGateway id="R06O" name="Change or correction?"/>
    <bpmn:serviceTask id="R07O" name="Record Keep, Defer or Exit outcome">
      <bpmn:documentation>For Keep, record a suitable no-change decision. For Defer, record the reason and permitted follow-up. For Exit, invoke the approved hand-off and record the status.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="R08O" name="Final status ready"/>
    <bpmn:exclusiveGateway id="R09O" name="Change selected?"/>
    <bpmn:callActivity id="R10O" name="Revalidate and fulfil selected change" calledElement="Process_Fulfilment_Optimised">
      <bpmn:documentation>Invoke the linked fulfilment process to revalidate the selected change before any fulfilment is recorded.</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:endEvent id="R11O" name="Fulfilment or assistance status ready"/>
    <bpmn:callActivity id="R12O" name="Prepare matched PlanFit output" calledElement="Process_Output_Optimised">
      <bpmn:documentation>Reuse the linked output process with corrected inputs while preserving the original arm and denominator record.</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:endEvent id="R13O" name="Revised output or assistance status ready"/>
    <bpmn:sequenceFlow id="RF01O" sourceRef="R01O" targetRef="R02O"/>
    <bpmn:sequenceFlow id="RF02O" sourceRef="R02O" targetRef="R03O"/>
    <bpmn:sequenceFlow id="RF03YO" name="Yes — Help" sourceRef="R03O" targetRef="R04O"/>
    <bpmn:sequenceFlow id="RF04O" sourceRef="R04O" targetRef="R05O"/>
    <bpmn:sequenceFlow id="RF03NO" name="No" sourceRef="R03O" targetRef="R06O"/>
    <bpmn:sequenceFlow id="RF06NO" name="No — Keep / Defer / Exit" sourceRef="R06O" targetRef="R07O"/>
    <bpmn:sequenceFlow id="RF07O" sourceRef="R07O" targetRef="R08O"/>
    <bpmn:sequenceFlow id="RF06YO" name="Yes" sourceRef="R06O" targetRef="R09O"/>
    <bpmn:sequenceFlow id="RF09YO" name="Yes — Change" sourceRef="R09O" targetRef="R10O"/>
    <bpmn:sequenceFlow id="RF10O" sourceRef="R10O" targetRef="R11O"/>
    <bpmn:sequenceFlow id="RF09NO" name="No — Correct" sourceRef="R09O" targetRef="R12O"/>
    <bpmn:sequenceFlow id="RF12O" sourceRef="R12O" targetRef="R13O"/>
  </bpmn:process>

  <bpmn:process id="Process_Fulfilment_Optimised" name="Revalidate and fulfil selected change" isExecutable="false">
    <bpmn:documentation>Linked child process that revalidates eligibility and terms before recording a suitability-valid fulfilled change.</bpmn:documentation>
    <bpmn:startEvent id="F01O" name="Change selected"/>
    <bpmn:businessRuleTask id="F02O" name="Revalidate eligibility, terms and effective date">
      <bpmn:documentation>Revalidate current eligibility, plan terms and effective date before fulfilment; do not rely only on the earlier display.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="F03O" name="Selection still valid?"/>
    <bpmn:serviceTask id="F04O" name="Return changed-terms or assistance status">
      <bpmn:documentation>Return the changed-terms or assistance-required status without fulfilling the original request when the selection is no longer valid.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F06NO" name="Assistance-required status ready"/>
    <bpmn:serviceTask id="F05O" name="Fulfil change and record valid acceptance">
      <bpmn:documentation>Fulfil the revalidated change and record the suitability-valid acceptance, decision version and effective status.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F06YO" name="Fulfilment status ready"/>
    <bpmn:sequenceFlow id="FF01O" sourceRef="F01O" targetRef="F02O"/>
    <bpmn:sequenceFlow id="FF02O" sourceRef="F02O" targetRef="F03O"/>
    <bpmn:sequenceFlow id="FF03NO" name="No" sourceRef="F03O" targetRef="F04O"/>
    <bpmn:sequenceFlow id="FF04O" sourceRef="F04O" targetRef="F06NO"/>
    <bpmn:sequenceFlow id="FF03YO" name="Yes" sourceRef="F03O" targetRef="F05O"/>
    <bpmn:sequenceFlow id="FF05O" sourceRef="F05O" targetRef="F06YO"/>
  </bpmn:process>

  <bpmn:process id="Process_Measurement_Optimised" name="Measure 90-day outcomes and guardrails" isExecutable="false">
    <bpmn:documentation>Independent timer-start supporting process for daily measurement of matured assigned cohorts, including non-completers.</bpmn:documentation>
    <bpmn:startEvent id="M01O" name="Daily matured-cohort cycle">
      <bpmn:timerEventDefinition id="EventDef_M01O">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="M02O" name="Extract all eligible assignments">
      <bpmn:documentation>Extract every eligible assignment in the matured cohort, including assigned customers who did not complete a review.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="M03O" name="Join outcome and guardrail events">
      <bpmn:documentation>Join assignment, display, response, fulfilment, churn and approved guardrail events using traceable identifiers.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="M04O" name="Apply analysis and data-quality rules">
      <bpmn:documentation>Apply the approved exclusions, censoring, missingness and data-quality rules before outcome calculation.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="M05O" name="Calculate ITT outcomes and guardrails">
      <bpmn:documentation>Calculate intention-to-treat churn, completion, valid acceptance and approved guardrails with uncertainty.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M06O" name="Material integrity or suitability exception?"/>
    <bpmn:userTask id="M07O" name="Pause, investigate or redesign">
      <bpmn:documentation>Pause the decision and investigate the exception; correct the analysis or redesign the proposed intervention before resuming when a material integrity, privacy or suitability exception is detected.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:endEvent id="M08YO" name="Governance action recorded"/>
    <bpmn:endEvent id="M08NO" name="Measurement cycle complete"/>
    <bpmn:sequenceFlow id="MF01O" sourceRef="M01O" targetRef="M02O"/>
    <bpmn:sequenceFlow id="MF02O" sourceRef="M02O" targetRef="M03O"/>
    <bpmn:sequenceFlow id="MF03O" sourceRef="M03O" targetRef="M04O"/>
    <bpmn:sequenceFlow id="MF04O" sourceRef="M04O" targetRef="M05O"/>
    <bpmn:sequenceFlow id="MF05O" sourceRef="M05O" targetRef="M06O"/>
    <bpmn:sequenceFlow id="MF06YO" name="Yes" sourceRef="M06O" targetRef="M07O"/>
    <bpmn:sequenceFlow id="MF07O" sourceRef="M07O" targetRef="M08YO"/>
    <bpmn:sequenceFlow id="MF06NO" name="No" sourceRef="M06O" targetRef="M08NO"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_PlanFit_Optimised_Main" name="PlanFit Navigator Core — Proposed TO-BE">
    <bpmndi:BPMNPlane id="Plane_Diagram_PlanFit_Optimised_Main" bpmnElement="Collaboration_PlanFit_Optimised">
      <bpmndi:BPMNShape id="Shape_Participant_Customer_Optimised" bpmnElement="Participant_Customer_Optimised" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1600" height="210"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Spark_Optimised" bpmnElement="Participant_Spark_Optimised" isHorizontal="true">
        <dc:Bounds x="40" y="300" width="1600" height="600"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Digital_Optimised" bpmnElement="Lane_Digital_Optimised" isHorizontal="true">
        <dc:Bounds x="70" y="300" width="1570" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Decision_Optimised" bpmnElement="Lane_Decision_Optimised" isHorizontal="true">
        <dc:Bounds x="70" y="470" width="1570" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Response_Optimised" bpmnElement="Lane_Response_Optimised" isHorizontal="true">
        <dc:Bounds x="70" y="600" width="1570" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Analytics_Optimised" bpmnElement="Lane_Analytics_Optimised" isHorizontal="true">
        <dc:Bounds x="70" y="730" width="1570" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C01O" bpmnElement="C01O">
        <dc:Bounds x="80" y="127" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C02O" bpmnElement="C02O">
        <dc:Bounds x="170" y="110" width="120" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C03O" bpmnElement="C03O">
        <dc:Bounds x="425" y="110" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C04MO" bpmnElement="C04MO" isMarkerVisible="true">
        <dc:Bounds x="655" y="120" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C04O" bpmnElement="C04O">
        <dc:Bounds x="755" y="105" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C05O" bpmnElement="C05O">
        <dc:Bounds x="990" y="110" width="120" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C06O" bpmnElement="C06O">
        <dc:Bounds x="1230" y="110" width="140" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C07O" bpmnElement="C07O" isMarkerVisible="true">
        <dc:Bounds x="1455" y="120" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C08O" bpmnElement="C08O">
        <dc:Bounds x="1560" y="127" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S01O" bpmnElement="S01O">
        <dc:Bounds x="212" y="347" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S02O" bpmnElement="S02O" isExpanded="false">
        <dc:Bounds x="305" y="495" width="150" height="80"/>
