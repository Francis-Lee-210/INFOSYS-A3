<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_A1D2_RevisedAsIs"
  targetNamespace="https://www.auckland.ac.nz/infosys704/a1-d2/as-is"
  exporter="Codex"
  exporterVersion="3.0-a1d2">

  <bpmn:message id="Message_DigitalRequest" name="Digital plan-review request"/>
  <bpmn:message id="Message_DigitalInformation" name="Plan-review information"/>
  <bpmn:message id="Message_AssistedRequest" name="Assisted-advice request"/>
  <bpmn:message id="Message_AssistedAdvice" name="Advice and available options"/>

  <bpmn:collaboration id="Collaboration_SimplifiedPlanReview"
    name="Spark Consumer Mobile Plan-Value Review — Revised AS-IS">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_Spark" name="Spark" processRef="Process_Spark"/>
    <bpmn:messageFlow id="MF_DigitalRequest" sourceRef="Task_RequestDigital" targetRef="Start_Digital"/>
    <bpmn:messageFlow id="MF_DigitalInformation" sourceRef="Task_PresentDigital" targetRef="Task_ReceiveDigital"/>
    <bpmn:messageFlow id="MF_AssistedRequest" sourceRef="Task_RequestAssisted" targetRef="Start_Assisted"/>
    <bpmn:messageFlow id="MF_AssistedAdvice" sourceRef="Task_ExplainOptions" targetRef="Task_ReceiveAdvice"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer" name="Customer plan-value decision" isExecutable="false">
    <bpmn:startEvent id="Start_Mismatch" name="Possible plan mismatch noticed"/>
    <bpmn:userTask id="Task_InitiateReview" name="Initiate plan review"/>
    <bpmn:exclusiveGateway id="Gateway_Channel" name="Preferred review route?"/>
    <bpmn:sendTask id="Task_RequestDigital" name="Request digital plan review"/>
    <bpmn:receiveTask id="Task_ReceiveDigital" name="Review information returned"/>
    <bpmn:exclusiveGateway id="Gateway_Evidence" name="Enough evidence to decide?"/>
    <bpmn:exclusiveGateway id="Gateway_AssistedMerge" name="Assisted paths rejoin"/>
    <bpmn:sendTask id="Task_RequestAssisted" name="Request assisted advice"/>
    <bpmn:receiveTask id="Task_ReceiveAdvice" name="Receive advice and options"/>
    <bpmn:exclusiveGateway id="Gateway_DecisionMerge" name="Decision paths rejoin"/>
    <bpmn:userTask id="Task_MakeDecision" name="Choose to stay, change, defer or exit"/>
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="Decision outcome"/>
    <bpmn:endEvent id="End_Stay" name="Stay on current plan"/>
    <bpmn:endEvent id="End_Change" name="Change plan"/>
    <bpmn:endEvent id="End_Leave" name="Defer, decline or exit"/>

    <bpmn:sequenceFlow id="CF_Start" sourceRef="Start_Mismatch" targetRef="Task_InitiateReview"/>
    <bpmn:sequenceFlow id="CF_Initiate" sourceRef="Task_InitiateReview" targetRef="Gateway_Channel"/>
    <bpmn:sequenceFlow id="CF_ChannelDigital" name="Digital" sourceRef="Gateway_Channel" targetRef="Task_RequestDigital"/>
    <bpmn:sequenceFlow id="CF_ChannelAssisted" name="Assisted" sourceRef="Gateway_Channel" targetRef="Gateway_AssistedMerge"/>
    <bpmn:sequenceFlow id="CF_RequestDigital" sourceRef="Task_RequestDigital" targetRef="Task_ReceiveDigital"/>
    <bpmn:sequenceFlow id="CF_ReceiveDigital" sourceRef="Task_ReceiveDigital" targetRef="Gateway_Evidence"/>
    <bpmn:sequenceFlow id="CF_EvidenceYes" name="Yes" sourceRef="Gateway_Evidence" targetRef="Gateway_DecisionMerge"/>
    <bpmn:sequenceFlow id="CF_EvidenceNo" name="No" sourceRef="Gateway_Evidence" targetRef="Gateway_AssistedMerge"/>
    <bpmn:sequenceFlow id="CF_AssistedMerge" sourceRef="Gateway_AssistedMerge" targetRef="Task_RequestAssisted"/>
    <bpmn:sequenceFlow id="CF_RequestAssisted" sourceRef="Task_RequestAssisted" targetRef="Task_ReceiveAdvice"/>
    <bpmn:sequenceFlow id="CF_ReceiveAdvice" sourceRef="Task_ReceiveAdvice" targetRef="Gateway_DecisionMerge"/>
    <bpmn:sequenceFlow id="CF_DecisionMerge" sourceRef="Gateway_DecisionMerge" targetRef="Task_MakeDecision"/>
    <bpmn:sequenceFlow id="CF_Decision" sourceRef="Task_MakeDecision" targetRef="Gateway_Outcome"/>
    <bpmn:sequenceFlow id="CF_Stay" name="Stay" sourceRef="Gateway_Outcome" targetRef="End_Stay"/>
    <bpmn:sequenceFlow id="CF_Change" name="Change" sourceRef="Gateway_Outcome" targetRef="End_Change"/>
    <bpmn:sequenceFlow id="CF_Leave" name="Defer / decline / exit" sourceRef="Gateway_Outcome" targetRef="End_Leave"/>

    <bpmn:textAnnotation id="Annotation_P1">
      <bpmn:text>D2 — VALIDATION HYPOTHESIS: review may start only after a customer concern; proactive timing is outside the documented customer-initiated path.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_P1" sourceRef="Task_InitiateReview" targetRef="Annotation_P1"/>
  </bpmn:process>

  <bpmn:process id="Process_Spark" name="Spark plan-review support" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Spark">
      <bpmn:lane id="Lane_Digital" name="MySpark / Digital">
        <bpmn:flowNodeRef>Start_Digital</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentDigital</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Digital</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assisted" name="Retail / Contact Centre">
        <bpmn:flowNodeRef>Start_Assisted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewContext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExplainOptions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Assisted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Digital" name="Digital review requested">
      <bpmn:messageEventDefinition id="MessageEvent_DigitalRequest" messageRef="Message_DigitalRequest"/>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_PresentDigital"
      name="Present current plan, available usage/spend information and plan options"/>
    <bpmn:endEvent id="End_Digital" name="Digital information returned"/>
    <bpmn:sequenceFlow id="SF_DigitalStart" sourceRef="Start_Digital" targetRef="Task_PresentDigital"/>
    <bpmn:sequenceFlow id="SF_DigitalEnd" sourceRef="Task_PresentDigital" targetRef="End_Digital"/>

    <bpmn:startEvent id="Start_Assisted" name="Assisted advice requested">
      <bpmn:messageEventDefinition id="MessageEvent_AssistedRequest" messageRef="Message_AssistedRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewContext" name="Review available customer context"/>
    <bpmn:sendTask id="Task_ExplainOptions" name="Explain options and available fit evidence"/>
    <bpmn:endEvent id="End_Assisted" name="Advice returned"/>
    <bpmn:sequenceFlow id="SF_AssistedStart" sourceRef="Start_Assisted" targetRef="Task_ReviewContext"/>
    <bpmn:sequenceFlow id="SF_AssistedExplain" sourceRef="Task_ReviewContext" targetRef="Task_ExplainOptions"/>
    <bpmn:sequenceFlow id="SF_AssistedEnd" sourceRef="Task_ExplainOptions" targetRef="End_Assisted"/>

    <bpmn:textAnnotation id="Annotation_P2">
      <bpmn:text>D1 — BOUNDED PUBLIC-DOCUMENTATION FINDING: the documented path does not demonstrate an explicit, understandable plan-fit conclusion.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_P3">
      <bpmn:text>D3–D5 — VALIDATION HYPOTHESES: cross-channel context, explanation consistency, eligibility treatment and outcome learning are not established by public evidence. This is not a Spark-validated internal process.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_P2" sourceRef="Task_PresentDigital" targetRef="Annotation_P2"/>
    <bpmn:association id="Association_P3" sourceRef="Task_ExplainOptions" targetRef="Annotation_P3"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_SimplifiedPlanReview">
    <bpmndi:BPMNPlane id="Plane_SimplifiedPlanReview" bpmnElement="Collaboration_SimplifiedPlanReview">
      <bpmndi:BPMNShape id="Shape_CustomerPool" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="2220" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SparkPool" bpmnElement="Participant_Spark" isHorizontal="true">
        <dc:Bounds x="80" y="480" width="2220" height="320"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DigitalLane" bpmnElement="Lane_Digital" isHorizontal="true">
        <dc:Bounds x="110" y="480" width="2190" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AssistedLane" bpmnElement="Lane_Assisted" isHorizontal="true">
        <dc:Bounds x="110" y="630" width="2190" height="170"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartMismatch" bpmnElement="Start_Mismatch">
        <dc:Bounds x="145" y="220" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InitiateReview" bpmnElement="Task_InitiateReview">
        <dc:Bounds x="220" y="195" width="150" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GatewayChannel" bpmnElement="Gateway_Channel" isMarkerVisible="true">
        <dc:Bounds x="420" y="213" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RequestDigital" bpmnElement="Task_RequestDigital">
        <dc:Bounds x="530" y="120" width="170" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReceiveDigital" bpmnElement="Task_ReceiveDigital">
        <dc:Bounds x="760" y="120" width="170" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GatewayEvidence" bpmnElement="Gateway_Evidence" isMarkerVisible="true">
        <dc:Bounds x="980" y="133" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AssistedMerge" bpmnElement="Gateway_AssistedMerge" isMarkerVisible="true"><dc:Bounds x="1015" y="288" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RequestAssisted" bpmnElement="Task_RequestAssisted">
        <dc:Bounds x="1080" y="275" width="170" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReceiveAdvice" bpmnElement="Task_ReceiveAdvice">
        <dc:Bounds x="1300" y="275" width="170" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DecisionMerge" bpmnElement="Gateway_DecisionMerge" isMarkerVisible="true"><dc:Bounds x="1440" y="200" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_MakeDecision" bpmnElement="Task_MakeDecision">
        <dc:Bounds x="1510" y="195" width="190" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GatewayOutcome" bpmnElement="Gateway_Outcome" isMarkerVisible="true">
        <dc:Bounds x="1750" y="213" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndStay" bpmnElement="End_Stay">
        <dc:Bounds x="1930" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndChange" bpmnElement="End_Change">
        <dc:Bounds x="1930" y="220" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndLeave" bpmnElement="End_Leave">
        <dc:Bounds x="1930" y="320" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AnnotationP1" bpmnElement="Annotation_P1">
        <dc:Bounds x="210" y="315" width="330" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartDigital" bpmnElement="Start_Digital">
        <dc:Bounds x="560" y="535" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PresentDigital" bpmnElement="Task_PresentDigital">
        <dc:Bounds x="650" y="515" width="260" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndDigital" bpmnElement="End_Digital">
        <dc:Bounds x="960" y="535" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AnnotationP2" bpmnElement="Annotation_P2">
        <dc:Bounds x="1050" y="505" width="420" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StartAssisted" bpmnElement="Start_Assisted">
        <dc:Bounds x="1080" y="700" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReviewContext" bpmnElement="Task_ReviewContext">
        <dc:Bounds x="1170" y="680" width="190" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ExplainOptions" bpmnElement="Task_ExplainOptions">
        <dc:Bounds x="1410" y="680" width="210" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndAssisted" bpmnElement="End_Assisted">
        <dc:Bounds x="1670" y="700" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AnnotationP3" bpmnElement="Annotation_P3">
        <dc:Bounds x="1770" y="665" width="440" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_CF_Start" bpmnElement="CF_Start"><di:waypoint x="181" y="238"/><di:waypoint x="220" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_Initiate" bpmnElement="CF_Initiate"><di:waypoint x="370" y="238"/><di:waypoint x="420" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_ChannelDigital" bpmnElement="CF_ChannelDigital"><di:waypoint x="470" y="238"/><di:waypoint x="530" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_ChannelAssisted" bpmnElement="CF_ChannelAssisted"><di:waypoint x="470" y="238"/><di:waypoint x="1015" y="313"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_RequestDigital" bpmnElement="CF_RequestDigital"><di:waypoint x="700" y="158"/><di:waypoint x="760" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_ReceiveDigital" bpmnElement="CF_ReceiveDigital"><di:waypoint x="930" y="158"/><di:waypoint x="980" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_EvidenceYes" bpmnElement="CF_EvidenceYes"><di:waypoint x="1030" y="158"/><di:waypoint x="1440" y="225"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_EvidenceNo" bpmnElement="CF_EvidenceNo"><di:waypoint x="1005" y="183"/><di:waypoint x="1040" y="288"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_AssistedMerge" bpmnElement="CF_AssistedMerge"><di:waypoint x="1065" y="313"/><di:waypoint x="1080" y="313"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_RequestAssisted" bpmnElement="CF_RequestAssisted"><di:waypoint x="1250" y="313"/><di:waypoint x="1300" y="313"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_ReceiveAdvice" bpmnElement="CF_ReceiveAdvice"><di:waypoint x="1470" y="313"/><di:waypoint x="1465" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_DecisionMerge" bpmnElement="CF_DecisionMerge"><di:waypoint x="1490" y="225"/><di:waypoint x="1510" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_Decision" bpmnElement="CF_Decision"><di:waypoint x="1700" y="238"/><di:waypoint x="1750" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_Stay" bpmnElement="CF_Stay"><di:waypoint x="1800" y="238"/><di:waypoint x="1930" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_Change" bpmnElement="CF_Change"><di:waypoint x="1800" y="238"/><di:waypoint x="1930" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CF_Leave" bpmnElement="CF_Leave"><di:waypoint x="1800" y="238"/><di:waypoint x="1930" y="338"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_AssociationP1" bpmnElement="Association_P1"><di:waypoint x="370" y="238"/><di:waypoint x="375" y="315"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_SF_DigitalStart" bpmnElement="SF_DigitalStart"><di:waypoint x="596" y="553"/><di:waypoint x="650" y="553"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_DigitalEnd" bpmnElement="SF_DigitalEnd"><di:waypoint x="910" y="553"/><di:waypoint x="960" y="553"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AssistedStart" bpmnElement="SF_AssistedStart"><di:waypoint x="1116" y="718"/><di:waypoint x="1170" y="718"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AssistedExplain" bpmnElement="SF_AssistedExplain"><di:waypoint x="1360" y="718"/><di:waypoint x="1410" y="718"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_AssistedEnd" bpmnElement="SF_AssistedEnd"><di:waypoint x="1620" y="718"/><di:waypoint x="1670" y="718"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_AssociationP2" bpmnElement="Association_P2"><di:waypoint x="910" y="553"/><di:waypoint x="910" y="495"/><di:waypoint x="1050" y="495"/><di:waypoint x="1050" y="545"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_AssociationP3" bpmnElement="Association_P3"><di:waypoint x="1515" y="680"/><di:waypoint x="1770" y="680"/><di:waypoint x="1770" y="705"/></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_MF_DigitalRequest" bpmnElement="MF_DigitalRequest"><di:waypoint x="615" y="196"/><di:waypoint x="578" y="535"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_DigitalInformation" bpmnElement="MF_DigitalInformation"><di:waypoint x="780" y="515"/><di:waypoint x="845" y="196"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_AssistedRequest" bpmnElement="MF_AssistedRequest"><di:waypoint x="1165" y="351"/><di:waypoint x="1040" y="351"/><di:waypoint x="1040" y="718"/><di:waypoint x="1080" y="718"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF_AssistedAdvice" bpmnElement="MF_AssistedAdvice"><di:waypoint x="1515" y="680"/><di:waypoint x="1470" y="313"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
